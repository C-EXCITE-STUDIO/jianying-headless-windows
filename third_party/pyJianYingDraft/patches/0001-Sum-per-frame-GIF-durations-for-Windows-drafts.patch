new file mode 100644
index 0000000..ba12163
--- /dev/null
+++ b/tests/test_gif_duration.py
@@ -0,0 +1,18 @@
+"""GIF 素材須保留每幀各自的顯示時長。"""
+
+from pathlib import Path
+import unittest
+
+from pyJianYingDraft.local_materials import VideoMaterial
+
+
+FIXTURE = Path(__file__).parent / "fixtures" / "variable_delay.gif"
+
+
+class GifDurationTests(unittest.TestCase):
+    def test_variable_delay_gif_uses_sum_of_frame_durations(self):
+        material = VideoMaterial(str(FIXTURE))
+
+        self.assertEqual(material.material_type, "video")
+        self.assertEqual(material.duration, 1_040_000)
+        self.assertEqual((material.width, material.height), (320, 180))
