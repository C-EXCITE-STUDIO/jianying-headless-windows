Date: Sat, 10 Oct 2026 04:26:22 +0800
Subject: [PATCH 1/2] Sum per-frame GIF durations for Windows drafts

---
 pyJianYingDraft/local_materials.py |  40 +++++++++++++++++++++--------
 tests/fixtures/variable_delay.gif  | Bin 0 -> 28526 bytes
 tests/test_gif_duration.py         |  18 +++++++++++++
 3 files changed, 47 insertions(+), 11 deletions(-)
 create mode 100644 tests/fixtures/variable_delay.gif
 create mode 100644 tests/test_gif_duration.py

diff --git a/pyJianYingDraft/local_materials.py b/pyJianYingDraft/local_materials.py
index 37164b9..c7f9c17 100644
--- a/pyJianYingDraft/local_materials.py
+++ b/pyJianYingDraft/local_materials.py
@@ -1,3 +1,4 @@
+import math
 import os
 import uuid
 import pymediainfo
@@ -153,8 +154,35 @@ class VideoMaterial:
 
         info: pymediainfo.MediaInfo = \
             pymediainfo.MediaInfo.parse(path, mediainfo_options={"File_TestContinuousFileNames": "0"})  # type: ignore
+        # GIF 的每帧时长可能不同，不能以第一帧时长乘以帧数。
+        if postfix.lower() == ".gif":
+            import imageio
+            gif = imageio.get_reader(path)
+            try:
+                frame_count = gif.get_length()
+                if not isinstance(frame_count, int) or frame_count <= 0:
+                    raise ValueError("GIF 帧数无效")
+                default_duration = gif.get_meta_data().get("duration")
+                durations = []
+                for index in range(frame_count):
+                    value = gif.get_meta_data(index=index).get("duration")
+                    if value is None:
+                        value = default_duration
+                    duration = _coerce_numeric(value, field_name=f"gif frame {index} duration")
+                    if not math.isfinite(duration) or duration <= 0:
+                        raise ValueError(f"GIF 第 {index} 帧时长无效")
+                    durations.append(duration)
+                self.material_type = "video"
+                self.duration = int(round(math.fsum(durations) * 1e3))
+                gif_track = (info.image_tracks or info.video_tracks)
+                if not gif_track:
+                    raise ValueError("GIF 没有图像轨道")
+                self.width = _coerce_int(getattr(gif_track[0], "width", None), field_name="gif width")
+                self.height = _coerce_int(getattr(gif_track[0], "height", None), field_name="gif height")
+            finally:
+                gif.close()
         # 有视频轨道的视为视频素材
-        if len(info.video_tracks):
+        elif len(info.video_tracks):
             video_track = info.video_tracks[0]
             general_track = info.general_tracks[0] if len(info.general_tracks) else None
             self.material_type = "video"
@@ -165,16 +193,6 @@ class VideoMaterial:
             ) * 1e3))
             self.width = _coerce_int(getattr(video_track, "width", None), field_name="video width")
             self.height = _coerce_int(getattr(video_track, "height", None), field_name="video height")
-        # gif文件使用imageio库获取长度
-        elif postfix.lower() == ".gif":
-            import imageio
-            gif = imageio.get_reader(path)
-
-            self.material_type = "video"
-            self.duration = int(round(gif.get_meta_data()['duration'] * gif.get_length() * 1e3))
-            self.width = _coerce_int(getattr(info.image_tracks[0], "width", None), field_name="gif width")
-            self.height = _coerce_int(getattr(info.image_tracks[0], "height", None), field_name="gif height")
-            gif.close()
         elif len(info.image_tracks):
             self.material_type = "photo"
             self.duration = 10800000000  # 相当于3h
